# Raw and derived data
data/Original Data/
data/*.features_labels.csv
data/processed/
!data/processed/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Notebooks and tooling
.ipynb_checkpoints/
.DS_Store

# Large model artifacts
*.pt
*.pth
*.onnx
*.tflite

# Reproducible training outputs (keep the folder layout, ignore generated results)
artifacts/*
!artifacts/.gitkeep
!artifacts/baseline/
!artifacts/benchmarks/
!artifacts/evaluation/
!artifacts/predictions/
!artifacts/rf_medium/
!artifacts/timelines/
artifacts/baseline/*
!artifacts/baseline/.gitkeep
artifacts/benchmarks/*
!artifacts/benchmarks/.gitkeep
artifacts/evaluation/*
!artifacts/evaluation/.gitkeep
artifacts/predictions/*
!artifacts/predictions/.gitkeep
artifacts/rf_medium/*
!artifacts/rf_medium/.gitkeep
artifacts/timelines/*
!artifacts/timelines/.gitkeep

# New pipeline outputs (regenerable; keep the folder layout + frozen fold assignment)
outputs/*
!outputs/.gitkeep
!outputs/folds.json
!outputs/evaluation/
outputs/evaluation/*
!outputs/evaluation/.gitkeep
!outputs/figures/
outputs/figures/*
!outputs/figures/.gitkeep
!outputs/models/
outputs/models/*
